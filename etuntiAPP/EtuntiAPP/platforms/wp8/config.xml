<?xml version='1.0' encoding='utf-8'?>
<widget id="fi.etunti.local" version="0.0.46" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <feature name="NfcPlugin">
        <param name="wp-package" value="NfcPlugin" />
    </feature>
    <feature name="Camera">
        <param name="wp-package" value="Camera" />
    </feature>
    <feature name="Notification">
        <param name="wp-package" value="Notification" />
    </feature>
    <feature name="File">
        <param name="wp-package" value="File" />
    </feature>
    <feature name="FileTransfer">
        <param name="wp-package" value="FileTransfer" />
    </feature>
    <feature name="Media">
        <param name="wp-package" value="Media" />
    </feature>
    <feature name="Device">
        <param name="wp-package" value="Device" />
    </feature>
    <feature name="AppVersion">
        <param name="wp-package" value="AppVersion" />
    </feature>
    <name>Etunti.fi</name>
    <description>
        Etunnin perus- ja lisätyökalut ovat suunniteltu ratkaisemaan puhdistusalan tyypilliset ongelmat. Yhden ohjelman avulla pyörität yritystoimintaasi ennen näkemättömän helposti.
    </description>
    <author email="laptopsr@gmail.com" href="http://etunti.fi">
        Etunti.fi
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <icon height="48" platform="wp8" src="res/wp8/icon-48.png" width="48" />
    <icon height="62" platform="wp8" src="res/wp8/icon-62-tile.png" width="62" />
    <icon height="173" platform="wp8" src="res/wp8/icon-173-tile.png" width="173" />
    <splash height="800" src="res/wp8/SplashScreenImage.jpg" width="480" />
    <preference name="AndroidPersistentFileLocation" value="Internal" />
</widget>
